/* 学生信息管理系统 - 统一浅色主题 */
QWidget {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "SimSun";
    font-size: 9pt;
    color: #1f2937;
}

QMainWindow, QDialog {
    background-color: #f5f7fb;
}

QLabel {
    background: transparent;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 4px;
    padding: 3px 6px;
    selection-background-color: #bfdbfe;
    selection-color: #111827;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QDateEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #2563eb;
}

QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled,
QDoubleSpinBox:disabled, QDateEdit:disabled {
    background-color: #f3f4f6;
    color: #6b7280;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QPushButton {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    padding: 4px 12px;
    color: #1f2937;
}

QPushButton:hover {
    background-color: #eff6ff;
    border-color: #93c5fd;
}

QPushButton:pressed {
    background-color: #dbeafe;
}

QPushButton:disabled {
    background-color: #f3f4f6;
    color: #9ca3af;
    border-color: #e5e7eb;
}

QPushButton#pushButton_login, QPushButton#pushButton_register,
QPushButton#pushButton_confirm, QPushButton#pushButton_save,
QPushButton#pushButton_confirmPassword, QPushButton#pushButton_confirmquestions,
QPushButton#pushButton_startBackup, QPushButton#pushButton_startRestore,
QPushButton#pushButton_selectBackup, QPushButton#pushButton_selectFolder {
    background-color: #2563eb;
    border: 1px solid #2563eb;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#pushButton_login:hover, QPushButton#pushButton_register:hover,
QPushButton#pushButton_confirm:hover, QPushButton#pushButton_save:hover,
QPushButton#pushButton_confirmPassword:hover, QPushButton#pushButton_confirmquestions:hover,
QPushButton#pushButton_startBackup:hover, QPushButton#pushButton_startRestore:hover {
    background-color: #1d4ed8;
    border-color: #1d4ed8;
}

QTableWidget, QTableView {
    background-color: #ffffff;
    alternate-background-color: #f8fafc;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    gridline-color: #eef2f7;
    selection-background-color: #dbeafe;
    selection-color: #111827;
}

QHeaderView::section {
    background-color: #f1f5f9;
    color: #334155;
    border: none;
    border-right: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
    padding: 5px 6px;
    font-weight: 600;
}

QTableCornerButton::section {
    background-color: #f1f5f9;
    border: none;
}

QListWidget {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    outline: none;
    padding: 2px;
}

QListWidget::item {
    padding: 6px 8px;
    border-radius: 4px;
}

QListWidget::item:selected {
    background-color: #dbeafe;
    color: #1e3a8a;
}

QListWidget::item:hover {
    background-color: #eff6ff;
}

QMenuBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e5e7eb;
}

QMenuBar::item {
    padding: 5px 10px;
    background: transparent;
}

QMenuBar::item:selected {
    background-color: #eff6ff;
    border-radius: 4px;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    padding: 4px;
}

QMenu::item {
    padding: 5px 18px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #dbeafe;
}

QToolBar {
    background-color: #ffffff;
    border: none;
    border-bottom: 1px solid #e5e7eb;
    spacing: 4px;
    padding: 3px;
}

QStatusBar {
    background-color: #eef2f7;
    color: #475569;
}

QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 8px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #334155;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #cbd5e1;
    border-radius: 5px;
    min-width: 24px;
}

QMessageBox {
    background-color: #ffffff;
}

QToolTip {
    background-color: #111827;
    color: #ffffff;
    border: none;
    padding: 4px 6px;
}
